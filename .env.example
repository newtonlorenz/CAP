# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cap
DB_PASSWORD=postgres

# Authentication
SECRET_KEY=generate-a-secure-random-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
EXTRACTION_TIMEOUT_MINUTES=30
EXTRACTION_PAGE_TIMEOUT_SECONDS=300

# OpenAI API (for AI-assisted PDF parsing)
# Get an API key from https://platform.openai.com/api-keys
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o  # Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
AI_REQUEST_TIMEOUT_SECONDS=120

# File uploads
UPLOAD_DIR=./uploads
BACKUP_DIR=./uploads/.system_backups
BACKUP_RETENTION_COUNT=20
BACKUP_UPLOAD_MAX_MB=2048
FRONTEND_CLIENT_MAX_BODY_SIZE=2048m

# OCR pipeline
OCR_ENABLED=false
OCR_MODE=image_only
OCR_LANGUAGES=eng
# Space-separated Debian packages to include in optional OCR images.
OCR_LANGUAGE_PACKAGES=tesseract-ocr-eng
OCR_TIMEOUT_SECONDS=600
OCR_IMAGE_PAGE_RATIO_THRESHOLD=0.5

# Parseability + vision fallback
PARSEABILITY_LOW_PAGE_THRESHOLD=0.58
PARSEABILITY_LOW_RATIO_THRESHOLD=0.15
VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_MAX_REGIONS_PER_DOC=24
VISION_FALLBACK_CONFIDENCE_THRESHOLD=0.75
VISION_FALLBACK_RENDER_DPI=180
VISION_ANCHOR_MIN_SIMILARITY=0.82

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional bootstrap admin (created on startup if missing)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Email mode:
# - smtp: send via SMTP_* settings
# - log: do not send; log emails for MVP/testing (not allowed in production)
EMAIL_MODE=disabled

# Optional SMTP (review reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# System admins can override Email and AI settings in CAP after installation.
FRONTEND_BASE_URL=http://localhost:5173

# Jira integration
JIRA_SYNC_TTL_MINUTES=15
JIRA_REQUEST_TIMEOUT_SECONDS=15

# Whole-installation backup and Jira administration: explicit admin user UUIDs.
# Company admins do not receive this authority automatically.
INSTALLATION_OPERATOR_IDS=[]
# Additional HTTPS Jira hostnames, if using a self-hosted installation.
JIRA_ALLOWED_HOSTS=[]
PDF_PREPROCESS_TIMEOUT_SECONDS=180
PDF_MAX_PAGES=300
BACKUP_EXPANDED_MAX_MB=8192
BACKUP_MAX_MEMBERS=50000
# Optional independent Page Feedback service (both URL and key, or neither).
# FEEDBACK_SERVICE_URL=http://127.0.0.1:8091
# FEEDBACK_SERVICE_KEY=
# FEEDBACK_PROJECT=cap

# Optional native PostgreSQL client directory; otherwise use PATH.
POSTGRES_BIN_DIR=

# Optional local structured PDF extraction; requires the structured container/extra.
PDF_STRUCTURE_ENGINE=native

# Optional hardware-location exemption. Empty means no certification exemption.
CLOUD_LOCATION_EXEMPTION_STANDARD=

# Optional TypeSafe source-verification enhancement (independent of AI_PROVIDER)
JEV_ENABLED=false
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
JEV_REQUEST_TIMEOUT_SECONDS=30
