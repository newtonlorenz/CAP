# Runtime
APP_ENV=production

# Public origin (source of truth for CORS, trusted hosts, and app links)
FRONTEND_BASE_URL=https://app.example.com

# Optional bundled edge domain. Only set this when CAP_EDGE_MODE=bundled.
APP_DOMAIN=

# Database
DB_PASSWORD=replace-with-strong-db-password
# Optional managed Postgres override. Leave blank for the default same-host Compose service.
DATABASE_URL=

# Redis / Celery
# Optional managed Redis override. Leave blank for the default same-host Compose service.
REDIS_URL=

# Auth
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Explicit trusted installation operators; tenant admin alone does not grant access.
INSTALLATION_OPERATOR_IDS=[]

# Uvicorn proxy trust: replace only with the actual ingress proxy IPs/CIDRs.
# Never use * where an untrusted client can reach the backend. See SECURITY.md.
FORWARDED_ALLOW_IPS=127.0.0.1

# Uploads
UPLOAD_DIR=./uploads
BACKUP_DIR=./uploads/.system_backups
BACKUP_RETENTION_COUNT=20
BACKUP_UPLOAD_MAX_MB=2048
BACKUP_EXPANDED_MAX_MB=8192
BACKUP_MAX_MEMBERS=50000
FRONTEND_CLIENT_MAX_BODY_SIZE=2048m
MAX_DOCUMENT_UPLOAD_MB=50
MAX_EVIDENCE_UPLOAD_MB=25
PDF_PREPROCESS_TIMEOUT_SECONDS=180
PDF_MAX_PAGES=300

# Atlassian Cloud is supported by default. Additional exact hosts require operator trust.
JIRA_ALLOWED_HOSTS=[]

# Optional AI extraction: none makes no external AI requests
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_REQUEST_TIMEOUT_SECONDS=60

# CORS / trusted hosts
CORS_ORIGINS=["https://app.example.com"]
ALLOWED_HOSTS=["app.example.com"]

# Optional first-deploy admin bootstrap. If you set one of these, set all three.
# Clear these after the first successful login and rotate the temporary password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional email: disabled or smtp in production; log is development-only
EMAIL_MODE=disabled

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# System admins can override Email and AI settings in CAP after installation.

# Local OCR requires a Tesseract installation (or the OCR container target).
OCR_ENABLED=false
OCR_LANGUAGES=eng
# Space-separated Debian packages to include in optional OCR images.
OCR_LANGUAGE_PACKAGES=tesseract-ocr-eng

# Optional native PostgreSQL client directory; otherwise use PATH.
POSTGRES_BIN_DIR=

# Optional local structured PDF extraction; requires the structured container/extra.
PDF_STRUCTURE_ENGINE=native

# Optional hardware-location exemption. Empty means no certification exemption.
CLOUD_LOCATION_EXEMPTION_STANDARD=
