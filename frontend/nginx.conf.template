log_format cap '$remote_addr - $remote_user [$time_local] "$request" '
               'status=$status bytes=$body_bytes_sent rt=$request_time '
               'host="$host" '
               'upstream_addr="$upstream_addr" upstream_status="$upstream_status" upstream_rt="$upstream_response_time" '
               'referer="$http_referer" ua="$http_user_agent"';

access_log /dev/stdout cap;
error_log /dev/stderr warn;

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size ${FRONTEND_CLIENT_MAX_BODY_SIZE};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    absolute_redirect off;
    ${FRONTEND_EXTRA_LOCATIONS}

    location = ${FRONTEND_BASE_PATH}api {
        return 308 ${FRONTEND_BASE_PATH}api/;
    }

    location ^~ ${FRONTEND_BASE_PATH}api/ {
        # Always proxy to the upstream /api/ so /api/v1/* stays /api/v1/*.
        proxy_pass ${API_PROXY_TARGET}/api/;
        # Only relevant for HTTPS upstreams; harmless for HTTP.
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host ${API_PROXY_HOST_HEADER};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        # Let the API reject oversized uploads before nginx buffers the whole body.
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_cache_bypass $http_upgrade;
    }

    location = ${FRONTEND_BASE_PATH}site-content.json {
        default_type application/json;
        try_files $uri =404;
    }

    location ${FRONTEND_BASE_PATH} {
        try_files $uri $uri/ ${FRONTEND_BASE_PATH}index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }
}
